{
  "name": "@stallning/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:oxlint --fix && pnpm run lint:eslint --fix",
    "lint:oxlint": "pnpm exec oxlint -c .oxlintrc.json .",
    "lint:eslint": "pnpm exec eslint .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6007 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:storybook:coverage": "vitest run --config vitest.storybook.config.ts --coverage",
    "i18n:coverage": "pnpm exec stallning-i18n-coverage -f ./i18n/locales",
    "i18n:coverage:namespace": "pnpm exec stallning-i18n-coverage -f ./i18n/locales --ns"
  },
  "dependencies": {
    "@stallning/nuxt-essentials": "workspace:^",
    "@stallning/ui": "workspace:^",
    "nuxt": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:",
    "@playwright/test": "catalog:",
    "@stallning/eslint": "workspace:^",
    "@stallning/oxlint": "workspace:^",
    "@stallning/storybook": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/vue3": "catalog:",
    "@storybook/vue3-vite": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "vitest": "catalog:"
  }
}
