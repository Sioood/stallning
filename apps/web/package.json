{
  "name": "@stallning/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "pnpx oxlint || true",
    "lint:eslint": "pnpm exec eslint .",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check .",
    "i18n:coverage": "node ./node_modules/@stallning/ui/node_modules/@stallning/nuxt-essentials/i18n/utils/coverage.ts -f ./i18n/locales",
    "i18n:coverage:namespace": "node ./node_modules/@stallning/ui/node_modules/@stallning/nuxt-essentials/i18n/utils/coverage.ts -f ./i18n/locales -n"
  },
  "dependencies": {
    "@stallning/ui": "workspace:*",
    "nuxt": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
