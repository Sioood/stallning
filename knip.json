{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {},
    "apps/web": {
      "entry": ["i18n/locales/**/*.ts"],
      "project": ["app/**/*.{ts,vue}", "i18n/**/*.{ts,json,yaml,yml}"],
      "ignoreDependencies": ["@stallning/ui", "vue", "vue-router", "@nuxt/kit"]
    },
    "packages/ui": {
      "entry": [
        "i18n/locales/**/*.ts",
        "app/components/**/*.vue",
        "yaml.d.ts",
        "app/compodium/**/*.vue"
      ],
      "project": ["app/**/*.{ts,vue}", "i18n/**/*.{ts,json,yaml,yml}", "*.d.ts"],
      "ignoreDependencies": ["vue-router", "vue-i18n", "@vueuse/core", "@vitejs/plugin-vue"],
      "ignoreUnresolved": [".*app/components/Toggle\\.vue$"]
    },
    "packages/nuxt-essentials": {
      "entry": ["i18n/locales/**/*.ts", "i18n/utils/namespace.ts", "yaml.d.ts"],
      "project": ["app/**/*.{ts,vue}", "i18n/**/*.{ts,json,yaml,yml}", "*.d.ts"],
      "ignoreDependencies": ["@takumi-rs/core", "vue-router"]
    }
  },
  "ignoreDependencies": ["@stallning/oxlint"]
}
