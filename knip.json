{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": ["scripts/sync/index.ts", ".changeset/*.ts"],
      "project": ["scripts/**/*.ts", ".changeset/*.ts"]
    },
    "apps/web": {
      "entry": ["i18n/locales/**/*.ts", "app/**/*.stories.ts", ".storybook/**/*.ts"],
      "project": ["app/**/*.{ts,vue}", "i18n/**/*.ts", ".storybook/**/*.ts"],
      "ignoreDependencies": ["@stallning/ui", "vue", "vue-router", "vue-i18n"]
    },
    "packages/config/oxlint": {
      "entry": [
        ".oxlintrc.json",
        "base.oxlintrc.json",
        "vue.oxlintrc.json",
        "tailwind.oxlintrc.json"
      ],
      "ignoreDependencies": ["oxlint-tailwindcss"]
    },
    "packages/ui": {
      "entry": [
        "i18n/locales/**/*.ts",
        "app/components/**/*.vue",
        "app/components/**/*.stories.ts",
        "app/composables/**/*.ts",
        "yaml.d.ts",
        "test/**/*.test.ts",
        "test/nuxt/plugins/i18n-vitest-stub.ts",
        "test/visual/stubs/nuxt-app.ts"
      ],
      "project": ["app/**/*.{ts,vue}", "scripts/**/*.ts", "test/**/*.ts", "i18n/**/*.ts", "*.d.ts"],
      "paths": {
        "~ui/*": ["./*"],
        "~nuxt-essentials/*": ["../nuxt-essentials/*"]
      },
      "ignoreDependencies": [
        "vue-router",
        "vue-i18n",
        "vitest-environment-nuxt",
        "@storybook/vue3"
      ],
      "ignoreBinaries": ["open"],
      "vitest": {
        "config": ["vitest.knip.config.ts"]
      }
    },
    "apps/storybook": {
      "entry": [".storybook/**/*.ts", "vitest.config.ts"],
      "project": [".storybook/**/*.ts", "vitest.config.ts"],
      "ignoreDependencies": ["@stallning/ui", "vue", "vue-i18n"],
      "ignoreBinaries": ["http-server"]
    },
    "packages/config/storybook": {
      "entry": ["src/index.ts", "src/stubs/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@storybook/addon-a11y",
        "@storybook/addon-docs",
        "@storybook/addon-links",
        "@storybook/addon-vitest",
        "vite"
      ]
    },
    "packages/nuxt-essentials": {
      "entry": ["i18n/locales/**/*.ts", "i18n/utils/namespace.ts", "yaml.d.ts"],
      "project": ["app/**/*.{ts,vue}", "i18n/**/*.ts", "*.d.ts"],
      "ignoreDependencies": ["@takumi-rs/core", "vue-router"],
      "ignoreBinaries": ["open"]
    }
  },
  "ignoreDependencies": ["@stallning/oxlint"]
}
