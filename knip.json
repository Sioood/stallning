{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {},
    "packages/ui": {
      "entry": ["i18n/locales/**/*.ts", "app/components/**/*.vue", "yaml.d.ts"],
      "project": ["app/**/*.{ts,vue}", "i18n/**/*.{ts,json,yaml,yml}", "*.d.ts"],
      "ignoreDependencies": ["@stallning/nuxt-essentials", "vue", "vue-router"]
    },
    "packages/nuxt-essentials": {
      "entry": ["i18n/locales/**/*.ts", "i18n/utils/namespace.ts", "yaml.d.ts"],
      "project": ["app/**/*.{ts,vue}", "i18n/**/*.{ts,json,yaml,yml}", "*.d.ts"],
      "ignoreDependencies": ["@takumi-rs/core", "vue-router"]
    }
  },
  "ignoreDependencies": ["@stallning/oxlint"]
}
