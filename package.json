{
  "name": "stallning",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "turbo run lint",
    "lint:oxlint": "turbo run lint:oxlint",
    "lint:eslint": "turbo run lint:eslint",
    "deps:check:minor": "pnpx taze minor -r",
    "deps:check:major": "pnpx taze major -r",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "check-types": "turbo run check-types",
    "verify": "bash ./scripts/verify.sh",
    "prepare": "husky || true",
    "pre-commit": "lint-staged",
    "changeset": "pnpm exec changeset",
    "changeset:conventional-commits": "node ./.changeset/changeset-conventional-commits.ts",
    "changeset:release": "pnpm exec changeset tag",
    "sync:merge": "node ./scripts/sync/index.ts merge",
    "sync:pick": "node ./scripts/sync/index.ts pick",
    "build": "turbo run build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "todoctor": "pnpx todoctor",
    "sync": "node ./scripts/sync/index.ts",
    "sync:status": "node ./scripts/sync/index.ts status",
    "sync:backport": "node ./scripts/sync/index.ts backport"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@changesets/read": "^0.6.7",
    "@changesets/types": "^6.1.0",
    "@changesets/write": "^0.4.0",
    "@clack/prompts": "catalog:",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@manypkg/get-packages": "^3.1.0",
    "@stallning/eslint": "workspace:^",
    "@stallning/oxlint": "workspace:^",
    "@stallning/typescript": "workspace:^",
    "@types/node": "catalog:",
    "commander": "catalog:",
    "consola": "^3.4.2",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "only-allow": "^1.2.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "lint-staged": {
    "**/*.{json,js,ts,md,yaml,yml}": [
      "pnpm exec oxfmt --write",
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix -c eslint.config.ts"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        100
      ],
      "scope-enum": [
        2,
        "always",
        [
          "config",
          "docs",
          "global",
          "sync"
        ]
      ],
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  },
  "engines": {
    "node": ">=25.8.0"
  },
  "packageManager": "pnpm@11.20.0"
}
