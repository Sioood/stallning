{
  "name": "stallning",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "turbo run lint",
    "lint:oxlint": "turbo run lint:oxlint",
    "lint:eslint": "turbo run lint:eslint",
    "deps:check:minor": "pnpx taze minor -r",
    "deps:check:major": "pnpx taze major -r",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "check-types": "turbo run check-types",
    "prepare": "husky || true",
    "pre-commit": "lint-staged",
    "changeset": "pnpm exec changeset",
    "changeset:conventional-commits": "node ./.changeset/changeset-conventional-commits.ts",
    "changeset:release": "pnpm exec changeset tag",
    "init": "node ./scripts/init.ts",
    "sync:merge": "node ./scripts/sync-from-minimal.ts",
    "sync:pick": "node ./scripts/pick-commits.ts",
    "build": "turbo run build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "todoctor": "pnpx todoctor"
  },
  "dependencies": {
    "@changesets/cli": "^2.30.0"
  },
  "devDependencies": {
    "@changesets/read": "^0.6.7",
    "@changesets/types": "^6.1.0",
    "@changesets/write": "^0.4.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@manypkg/get-packages": "^3.1.0",
    "@stallning/eslint": "workspace:^",
    "@stallning/oxlint": "workspace:^",
    "@stallning/typescript": "workspace:^",
    "@types/minimist": "catalog:",
    "@types/node": "catalog:",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.3.1",
    "lint-staged": "^16.4.0",
    "minimist": "^1.2.8",
    "only-allow": "^1.2.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.9.5",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/*.{json,js,ts,md,yaml,yml}": [
      "oxlint --fix",
      "eslint --fix -c eslint.config.ts",
      "pnpm exec oxfmt --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        100
      ],
      "scope-enum": [
        2,
        "always",
        [
          "global",
          "config",
          "docs",
          "nuxt-essentials",
          "ui",
          "web"
        ]
      ],
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  },
  "engines": {
    "node": ">=25.8.0"
  },
  "packageManager": "pnpm@10.33.0"
}
