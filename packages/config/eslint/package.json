{
  "name": "@stallning/eslint",
  "version": "1.2.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "files": [
    "index.ts",
    "eslint.config.ts"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "pnpx oxlint",
    "lint:eslint": "eslint . --ext .ts,.js",
    "format": "pnpm --filter @stallning/oxfmt exec oxfmt --write .",
    "format:check": "pnpm --filter @stallning/oxfmt exec oxfmt --check .",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@stallning/oxfmt": "workspace:^",
    "@stallning/oxlint": "workspace:^",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "catalog:",
    "eslint-flat-config-utils": "^3.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-oxlint": "^1.59.0",
    "eslint-plugin-yml": "^3.3.1",
    "jiti": "^2.6.1",
    "jsonc-eslint-parser": "^3.1.0",
    "oxlint": "catalog:",
    "typescript-eslint": "^8.58.1",
    "yaml-eslint-parser": "^2.0.0"
  },
  "lint-staged": {
    "**/*.{json,js,ts,md,yaml,yml}": [
      "oxlint --fix",
      "eslint --fix",
      "pnpm --filter @stallning/oxfmt exec oxfmt --write"
    ]
  }
}
