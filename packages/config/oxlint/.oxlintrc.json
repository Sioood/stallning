{
  "plugins": ["typescript", "unicorn", "oxc"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/no-array-for-each": "error",
    "max-params": ["error", { "max": 3 }]
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**"]
}
