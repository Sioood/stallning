{
  "name": "@stallning/nuxt-essentials",
  "private": true,
  "bin": {
    "stallning-i18n-coverage": "./stallning-i18n-coverage.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "pnpm exec oxlint",
    "lint:eslint": "pnpm exec eslint .",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check .",
    "i18n:coverage": "node ./i18n/utils/coverage.ts -f ./i18n/locales",
    "i18n:coverage:namespace": "node ./i18n/utils/coverage.ts -f ./i18n/locales --ns",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxtjs/i18n": "10.2.4",
    "@nuxtjs/seo": "5.1.2",
    "@pinia/nuxt": "0.11.3",
    "@takumi-rs/core": "^0.73.1",
    "@vueuse/nuxt": "14.2.1",
    "nuxt": "catalog:",
    "nuxt-security": "2.5.1",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@nuxt/kit": "catalog:",
    "@stallning/eslint": "workspace:^",
    "@stallning/oxlint": "workspace:^",
    "@vitest/coverage-v8": "catalog:",
    "consola": "^3.4.2",
    "es-main": "^1.3.0",
    "minimist": "^1.2.8",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
