{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "sortTailwindcss": {
    "stylesheet": "app/assets/css/main.css",
    "functions": ["cn", "clsx", "cva", "twMerge", "twJoin", "ctl", "cc", "clb", "cnb"]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/pnpm-lock.yaml",
    "app/assets/css/tw-animate.css"
  ],
  "semi": false,
  "singleQuote": true
}
