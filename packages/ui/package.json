{
  "name": "@stallning/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "pnpx oxlint || true",
    "lint:eslint": "pnpm exec eslint .",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check .",
    "i18n:coverage": "node ./node_modules/@stallning/nuxt-essentials/i18n/utils/coverage.ts -f ./i18n/locales",
    "i18n:coverage:namespace": "node ./node_modules/@stallning/nuxt-essentials/i18n/utils/coverage.ts -f ./i18n/locales -n"
  },
  "dependencies": {
    "@compodium/nuxt": "0.1.0-beta.12",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@stallning/nuxt-essentials": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "class-variance-authority": "catalog:",
    "nuxt": "catalog:",
    "v-gsap-nuxt": "1.5.12",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:",
    "@stallning/eslint": "workspace:^",
    "@stallning/oxlint": "workspace:^"
  }
}
