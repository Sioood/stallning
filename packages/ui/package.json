{
  "name": "@stallning/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "pnpm exec oxlint",
    "lint:eslint": "pnpm exec eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project ui-unit",
    "test:component": "vitest run --project ui-component",
    "test:watch": "vitest",
    "mutation": "stryker run --incremental",
    "mutation:open": "stryker run --incremental && open reports/stryker-mutation.html",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check .",
    "i18n:coverage": "pnpm exec stallning-i18n-coverage -f ./i18n/locales",
    "i18n:coverage:namespace": "pnpm exec stallning-i18n-coverage -f ./i18n/locales --ns"
  },
  "dependencies": {
    "@ark-ui/vue": "catalog:",
    "@compodium/nuxt": "0.1.0-beta.12",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@stallning/nuxt-essentials": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/form-core": "1.29.1",
    "@tanstack/vue-form": "catalog:",
    "class-variance-authority": "catalog:",
    "nuxt": "catalog:",
    "tailwind-merge": "catalog:",
    "v-gsap-nuxt": "1.5.12",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/test-utils": "^4.0.3",
    "@stallning/eslint": "workspace:^",
    "@stallning/oxlint": "workspace:^",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "vitest": "catalog:"
  }
}
